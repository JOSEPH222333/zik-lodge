NODE_ENV=development
PORT=4000
CLIENT_URL=http://127.0.0.1:5173
ENFORCE_HTTPS=false

# Managed PostgreSQL, for example Neon, Supabase, Railway, Render, or AWS RDS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/zik_lodge?sslmode=require

# Production secrets. Change every value before deployment.
JWT_SECRET=change-this-long-random-jwt-secret
AUDIT_SECRET=change-this-long-random-audit-secret

# Admin seed account. Change these to your private admin login.
ADMIN_NAME=Zik Lodge Admin
ADMIN_EMAIL=admin@ziklodge.test
ADMIN_PHONE=+2348000000000
ADMIN_PASSWORD=Password123!

# Support email
SUPPORT_EMAIL=myappziklodg@gmail.com

# SMTP provider for real OTP email sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=myappziklodg@gmail.com
SMTP_PASS=replace-with-app-password
SMTP_FROM="Zik Lodge <myappziklodg@gmail.com>"

# Cloudinary storage for profile images, lodge images, and verification documents.
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# NIN verification is disabled for now.
# NIN_VERIFICATION_API_URL=https://your-nin-provider.example.com/verify
# NIN_VERIFICATION_API_KEY=replace-me
